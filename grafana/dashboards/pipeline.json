{
  "uid": "monitoring-pipeline",
  "title": "Monitoring pipeline health",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "monitoring"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "title": "Backend availability",
      "type": "stat",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"prometheus|grafana|alloy|loki|tempo|alertmanager\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Collector export queue",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "File log drops",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_write_dropped_entries_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Active metric series",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_head_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Collector export queue utilization",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size{data_type=~\"traces|logs\"} / otelcol_exporter_queue_capacity{data_type=~\"traces|logs\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Monitoring process memory",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"prometheus|grafana|alloy|loki|tempo|alertmanager\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
